:ret
    -> <= <-
    1 +
    jump

:println =>
    print
    "\n" print
    ret

:dup2 =>
    => => -> => dup -> dup <= <- <= <= -> <= <- <= <= <-
    ret

:swap =>
    => => -> => <= -> <= <- <= <-
    ret

:ask =>
    print input
    ret

:format_bool =>
    "std_format_bool_true" goto_if

    "false" ret
    
    :std_format_bool_true
    "true" ret

:not =>
    "std_not_true" goto_if

    1 ret
    
    :std_not_true
    0 ret

:reverse =>
    dup len =>
    0
    :std_reverse_first_move_start
        -> <= <- !dup2 == "std_reverse_first_move_end" goto_if
        =>
        !dup2 .
        => -> => <-
        1 +
        std_reverse_first_move_start
    :std_reverse_first_move_end

    => pop pop "" ->

    :std_reverse_second_move_start
        dup 0 == "std_reverse_second_move_end" goto_if
        1 -
        ->
        <= <- <= <- concat
        ->
        std_reverse_second_move_start
    :std_reverse_second_move_end
    pop <-

    ret

:spill_right =>
    -> => <-
    :std_spill_right_aux
        empty "std_spill_right_ret" goto_if
        =>
        std_spill_right_aux

    :std_spill_right_ret
        -> -> <= <- <-
        ret

:spill_left =>
    -> => <-
    :std_spill_left_aux
        empty "std_spill_left_ret" goto_if
        <=
        std_spill_left_aux

    :std_spill_left_ret
        -> -> <= <- <-
        ret

:switch_many_right
    // stack: n pc
    !swap
    dup 0 == "std_switch_many_right_ret" goto_if
    1 -
    => =>
    ->
    std_switch_many_right

    :std_switch_many_right_ret
        pop
        => ret

:switch_many_left
    // stack: n pc
    !swap
    dup 0 == "std_switch_many_left_ret" goto_if
    1 -
    <= <=
    <-
    std_switch_many_left

    :std_switch_many_left_ret
        pop
        => ret

:map 
    // xs ys func pc
    => -> => -> => <- <- // move pc by 3 stacks
    => -> => <- // move function label by 2 stacks

    :std_map_aux
        empty "std_map_ret" goto_if
        => ->
        (! 10 +) ->
        dup <= <-
        1 !swap goto_if
        <- <-
        std_map_aux
    
    :std_map_ret
        -> -> pop
        <- !spill_left
        -> -> <= <- <= <- <-
        ret

:? =>
    dup "std_try_unwrap" goto_if
    -> pop <-
    ret

    :std_try_unwrap
        pop ret
        

:stdlib
